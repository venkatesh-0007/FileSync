# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Cron Secret for Vercel Cron Authentication
# Keep this secret secure and configure the same value in Vercel Project Settings > Environment Variables
CRON_SECRET=your_cron_secret

# Storage Quota Configuration (Optional - defaults to 500 MB)
NEXT_PUBLIC_STORAGE_LIMIT_MB=500
